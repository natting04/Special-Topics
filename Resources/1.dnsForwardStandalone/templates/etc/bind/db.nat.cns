;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	nat.cns. root.nat.cns. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	nat.cns.
@	IN	A	192.168.177.41
@	IN	MX      10      mail

internetworking.1.srv   IN      A     192.168.177.41
www     IN      CNAME   internetworking.1.srv
mail    IN      A       192.168.177.41
